# Copy settings into the root .env file; never commit actual secrets.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/trading
AUTH_URL=http://localhost:3000
AUTH_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Server-side practice simulation settings. No broker/API key is required.
PRACTICE_INITIAL_BALANCE=100000
PRACTICE_FEE_BPS=0
PRACTICE_SLIPPAGE_BPS=0
